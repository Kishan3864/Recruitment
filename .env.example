# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical public URL (no trailing slash). Used for metadata, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database (Phase 2) ───────────────────────────────────────────────────────
# Local dev without Postgres:  DATABASE_PROVIDER="sqlite"  DATABASE_URL="file:./dev.db"
# Production (VPS Postgres):   DATABASE_PROVIDER="postgresql"
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# ── Email / SMTP (Phase 5+) ──────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Where application/lead notifications are delivered
NOTIFICATIONS_EMAIL=""

# ── Auth (Phase 8) ───────────────────────────────────────────────────────────
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Analytics (optional, gated by cookie consent) ────────────────────────────
NEXT_PUBLIC_GA_ID=""
