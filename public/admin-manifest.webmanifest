{
  "id": "/admin",
  "name": "Recruitment Admin",
  "short_name": "Admin",
  "description": "Command center for the recruitment site — content, jobs and inbox in one app.",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#eff6ff",
  "theme_color": "#ffffff",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/icons/admin-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/admin-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/admin-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Inbox",
      "url": "/admin/submissions",
      "icons": [{ "src": "/icons/admin-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New job",
      "url": "/admin/content/jobs/new",
      "icons": [{ "src": "/icons/admin-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Site settings",
      "url": "/admin/settings",
      "icons": [{ "src": "/icons/admin-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
